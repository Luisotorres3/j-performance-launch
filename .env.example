# Public browser configuration only. Never put private keys in VITE_* variables.
VITE_GA_MEASUREMENT_ID=
# EmailJS public identifiers, not email account credentials.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Public reCAPTCHA v2 site key. Configure its SECRET only in the EmailJS dashboard.
VITE_RECAPTCHA_SITE_KEY=
